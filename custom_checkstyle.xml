<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="severity" value="warning"/>

    <!-- ۱. حداکثر طول خط: ۱۲۰ کاراکتر -->
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">
        <!-- ۲. قوانین نام‌گذاری طبق داکیومنت -->
        <module name="TypeName"/>              <!-- کلاس‌ها و اینترفیس‌ها: PascalCase -->
        <module name="MethodName"/>            <!-- متدها: camelCase -->
        <module name="ParameterName"/>         <!-- پارامترها: camelCase -->
        <module name="LocalVariableName"/>     <!-- متغیرهای محلی: camelCase -->
        <module name="MemberName"/>            <!-- فیلدها: camelCase -->
        <module name="ConstantName"/>          <!-- ثابت‌ها: CONSTANT_CASE -->

        <!-- ۳. محدودیت طول متد و کلاس‌های بی‌نام -->
        <module name="MethodLength">
            <property name="max" value="50"/>  <!-- متدها حداکثر ۵۰ خط -->
        </module>
        <module name="AnonInnerLength">
            <property name="max" value="30"/>  <!-- کلاس‌های بی‌نام حداکثر ۳۰ خط -->
        </module>
    </module>
</module>
